# ============================================================================
# ChasFlip on-chain contracts — variables de entorno (Hardhat + Polygon Amoy)
# ============================================================================
# Copia este archivo a `.env.local` y completa los valores. NUNCA commitear
# `.env.local`; ya está en `.gitignore`.
#
# Las dos primeras llaves se generan automaticamente con:
#   npm run generate-wallets
# Para mainnet (produccion real), ROTA esas wallets y regenera.
# ============================================================================

# Llave privada del deployer (despliega el Vault, recibe ownership).
# Necesita MATIC en Amoy → https://faucet.polygon.technology/ → seleccionar Amoy.
DEPLOYER_PRIVATE_KEY=0x

# Address publica del server signer. La privkey vive en Supabase Edge Function
# secrets (SERVER_SIGNER_PRIVATE_KEY). El contrato Vault solo guarda la ADDRESS.
SERVER_SIGNER_ADDRESS=0x

# RPC URLs. Por defecto usamos endpoints publicos pero conviene usar Alchemy/
# Infura cuando haya volumen (mas estable).
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://polygon-rpc.com

# Polygonscan API key (para verificar contratos con `hardhat verify`).
# Crear gratis: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=
