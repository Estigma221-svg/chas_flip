# ChasFlip — variables Vite (copia a `.env.local`)
#
# Producto: matching PvP + contrato escrow — ambos depositan S → bote 2S → ganador 2S(1-fee), fee a treasury.
#
# Red EVM L2 (Privy / Magic): base-sepolia | base | polygon | polygon-amoy
VITE_CHAIN_KEY=base-sepolia

# mock = demo local | onchain = contrato (stub hasta implementar)
VITE_FLIP_ENGINE=mock

# Opcional: RPC propio
# VITE_RPC_URL=

# Opcional: RPC dedicado de Polygon (Alchemy, Infura, QuickNode…).
# Si no se pone, wagmi usa el RPC público (rate-limited, ok para dev/staging).
# VITE_RPC_URL_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# WalletConnect Cloud projectId (gratis en https://cloud.reown.com).
# Sin esto, solo se podrán conectar wallets inyectadas (MetaMask, Coinbase
# Wallet, Rabby). Las wallets móviles que usan WalletConnect NO se conectarán.
# VITE_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID

# Contrato flip cuando exista
# VITE_FLIP_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Tesorería / admin: recibe 2·S·fee en cada partida escrow (misma dirección que en el constructor del contrato; solo pública en el front)
# VITE_PROTOCOL_TREASURY=0x0000000000000000000000000000000000000000

# ---- Supabase: matching tiempo real + comisión en servidor -----------------
# Ejecuta `supabase/migrations/*.sql` en el Editor SQL del proyecto O `supabase db push`.
# Auth → Providers → activar "Anonymous sign-ins".
VITE_USE_SUPABASE_MATCHMAKING=false
# VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Opcional — si no despliegas Edge Functions el cliente llamará RPC directamente:
# npx supabase functions deploy matchmaking resolve-match cancel-matchmaking --project-ref YOUR_REF

# ---- Vault on-chain (Fase 2.C.1) ------------------------------------------
# Activar el flujo on-chain (Depositar/Retirar real) seteando estas 3 vars.
# Si quedan vacias, el frontend cae al flujo demo-only.
#
# Polygon Amoy (testnet):
#   VITE_VAULT_CHAIN_ID=80002
#   VITE_VAULT_ADDRESS=0x...     ← devuelto por `npm run deploy:amoy:vault`
#   VITE_VAULT_TOKEN_ADDRESS=0x..  (MockUSDT deployado por deploy:amoy:mock-usdt)
#
# Polygon mainnet:
#   VITE_VAULT_CHAIN_ID=137
#   VITE_VAULT_ADDRESS=0x...
#   VITE_VAULT_TOKEN_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F  ← USDT real
# VITE_VAULT_CHAIN_ID=80002
# VITE_VAULT_ADDRESS=
# VITE_VAULT_TOKEN_ADDRESS=
